---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const postsIn = (category: "linux" | "ansible" | "projects") =>
  posts.filter(post => post.data.category === category);
const featuredProjects = postsIn("projects").slice(0, 3);
const linuxPosts = postsIn("linux").slice(0, 3);
const ansiblePosts = postsIn("ansible").slice(0, 3);
const skills = ["Linux", "Ansible", "Terraform", "Proxmox", "Docker", "Git"];
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout my-1">
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <p class="text-accent font-medium">SysOps Engineer</p>
      <h1 class="my-3 text-4xl font-bold sm:text-5xl">Youssef Rhani</h1>
      <p>
        I work with Linux systems and infrastructure automation, using tools
        like Ansible and Terraform to make operations more reliable.
      </p>
      <p class="mt-2">
        TODO: Personalize this introduction with the kind of systems and
        challenges you focus on.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="me-1">Find me on:</span>
        <Socials />
      </div>
    </section>

    <section id="skills" class="border-border border-b py-8">
      <h2 class="mb-4 text-2xl font-semibold tracking-wide">Skills</h2>
      <ul class="flex flex-wrap gap-3">
        {
          skills.map(skill => (
            <li class="bg-muted text-foreground rounded-full px-3 py-1 text-sm font-medium">
              {skill}
            </li>
          ))
        }
      </ul>
    </section>

    <section id="featured-projects" class="border-border border-b py-8">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-2xl font-semibold tracking-wide">Featured projects</h2>
        <a
          href={getRelativeLocaleUrl(locale, "projects")}
          class="text-accent underline decoration-dashed underline-offset-4"
        >
          All projects
        </a>
      </div>
      <ul>
        {featuredProjects.map(data => <Card variant="h3" {...data} />)}
      </ul>
    </section>

    <section id="linux-procedures" class="border-border border-b py-8">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-2xl font-semibold tracking-wide">Latest Linux procedures</h2>
        <a
          href={getRelativeLocaleUrl(locale, "linux")}
          class="text-accent underline decoration-dashed underline-offset-4"
        >
          All Linux articles
        </a>
      </div>
      <ul>{linuxPosts.map(data => <Card variant="h3" {...data} />)}</ul>
    </section>

    <section id="ansible-procedures" class="py-8">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-2xl font-semibold tracking-wide">
          Latest Ansible procedures
        </h2>
        <a
          href={getRelativeLocaleUrl(locale, "ansible")}
          class="text-accent underline decoration-dashed underline-offset-4"
        >
          All Ansible articles
        </a>
      </div>
      <ul>{ansiblePosts.map(data => <Card variant="h3" {...data} />)}</ul>
    </section>
  </main>
  <Footer />
</Layout>
